{
  "name": "dsh-meter",
  "description": "DeepSeek Harness web 用量计费展示：高峰/低谷时段、会话预估消费、账户余额。",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-default-model": "^0.2.0-rc.0",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.0-rc.0",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.0",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.0",
    "@deepseek-ai/dsh-session-query": "^0.2.0-rc.0",
    "@deepseek-ai/dsh-shell": "^0.2.0-rc.0",
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rieide/dsh-meter.git"
  }
}
